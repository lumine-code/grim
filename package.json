{
  "name": "@lumine-code/grim",
  "version": "1.0.0",
  "description": "Tracks deprecated API calls and the code that made them.",
  "license": "MIT",
  "main": "./src/grim.js",
  "scripts": {
    "test": "jasmine",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write ."
  },
  "repository": "https://github.com/lumine-code/grim",
  "bugs": "https://github.com/lumine-code/grim/issues",
  "homepage": "https://github.com/lumine-code/grim/",
  "author": "lumine-code",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "src",
    "THIRD_PARTY_NOTICES"
  ],
  "keywords": [
    "grim",
    "deprecation",
    "call-site",
    "stack-trace",
    "diagnostics",
    "lumine"
  ],
  "dependencies": {
    "@lumine-code/event-kit": "github:lumine-code/event-kit#f5ebd3047253571a604d95de860ced633e0643f7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "jasmine": "^7.0.0",
    "prettier": "^3.10.1"
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.8"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.8"
    },
    "jasmine@^7.0.0": {
      "glob": "14.0.5"
    }
  }
}
